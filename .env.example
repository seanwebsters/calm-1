# ─────────────────────────────────────────────────────────────────────────────
# Calm-1 environment. Copy to .env.local for development. Never commit secrets.
# Everything is optional for local development except where noted – missing
# integrations show as "Not configured" in the dashboard instead of faking it.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of this deployment (used to show the webhook URL in Settings)
APP_URL=http://localhost:3000

# ── Data ────────────────────────────────────────────────────────────────────
# supabase (production) | local (JSON file in DATA_DIR, single process) | memory (tests)
# Defaults to supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, else local.
DATA_BACKEND=
DATA_DIR=./.data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only – bypasses RLS, never expose to the browser
SUPABASE_ANON_KEY=                  # only used for Supabase Auth sign-in

# REQUIRED in production. 32 random bytes, base64: `openssl rand -base64 32`
# Encrypts message text, memories, journal entries and phone numbers.
# Rotating it makes existing ciphertext unreadable – plan a re-encryption job first.
DATA_ENCRYPTION_KEY=
# REQUIRED in production. Random string used to hash phone numbers for lookup.
PHONE_HASH_PEPPER=

# ── Admin auth ──────────────────────────────────────────────────────────────
# local = single shared passcode (dev / small pilots); supabase = named accounts
AUTH_PROVIDER=local
ADMIN_PASSCODE=                     # required for local auth in production
SESSION_SECRET=                     # REQUIRED in production, 32+ chars: `openssl rand -hex 32`

# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Meta WhatsApp Cloud API ─────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=              # System User permanent token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=       # for template sync/submission
WHATSAPP_APP_SECRET=                # validates X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN=              # any random string; enter the same in Meta's webhook config
WHATSAPP_GRAPH_VERSION=v23.0

# ── Voice notes (optional) ──────────────────────────────────────────────────
ELEVENLABS_API_KEY=                 # Scribe speech-to-text

# ── Background work ─────────────────────────────────────────────────────────
CRON_SECRET=                        # Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
IN_PROCESS_WORKER=                  # 1 = run the scheduler inside the web process (default in dev)

# ── Rate limiting across instances (optional) ───────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
